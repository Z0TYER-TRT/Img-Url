# --- Site ---------------------------------------------------------------
# Your DuckDNS name without the https:// part. Caddy uses it for the cert.
PUBLIC_HOST=myimages.duckdns.org
# Full origin the API puts in generated links (scheme + host).
PUBLIC_ORIGIN=https://myimages.duckdns.org

# DuckDNS token — used only by scripts/duckdns.sh to update the A record.
# The app itself never reads this. Leave empty if you set the IP in the dashboard.
DUCKDNS_TOKEN=

# --- Admin login --------------------------------------------------------
# The single account that can upload. Password: 8 to 15 characters.
ADMIN_EMAIL=you@gmail.com
ADMIN_PASSWORD=changeme123
# 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=replace-with-32-plus-random-characters

# --- Database -----------------------------------------------------------
# The bundled container (default). For MongoDB Atlas, use the URI from
# Connect -> Drivers and keep the /imgurl database name, e.g.
#   MONGODB_URI=mongodb+srv://user:pass@cluster0.abc123.mongodb.net/imgurl?retryWrites=true&w=majority
# then stop the local one: `docker compose stop mongo`
MONGODB_URI=mongodb://mongo:27017/imgurl

# --- Storage ------------------------------------------------------------
# One line of JSON: an array of 1 to 10 Backblaze B2 accounts.
#
# Where the values come from:
#   B2 dashboard -> Application Keys -> Add a New Application Key
#     keyID        = "keyID" shown on creation      (S3: Access Key ID)
#     appKey       = "applicationKey"               (S3: Secret Access Key)
#     bucket       = the bucket you made, must be unique across entries
#     region       = the bucket's region, e.g. us-west-004
#   Give the key access to that one bucket with capabilities:
#     listFiles, readFiles, writeFiles, deleteFiles
#
# One account is enough to start:
B2_ACCOUNTS=[{"keyId":"0000000000000","appKey":"K00000000000000000000000000000000000","bucket":"my-imgurl-bucket","region":"us-west-004"}]
#
# More accounts: add objects to the same array, one line, up to 10.
# New uploads go to the account holding the fewest files; the rest are failover.
# Different buckets may live in different regions — each entry carries its own.
#
# B2_ACCOUNTS=[{"keyId":"KEY_A","appKey":"SECRET_A","bucket":"imgurl-a","region":"us-west-004"},{"keyId":"KEY_B","appKey":"SECRET_B","bucket":"imgurl-b","region":"eu-central-003"},{"keyId":"KEY_C","appKey":"SECRET_C","bucket":"imgurl-c","region":"us-east-005"}]
#
# Keep the array on a single line: one entry per line is not valid JSON for env.
# Never remove an entry while files live in that bucket — the app boots fine but
# those links answer 404, because each file records only its bucket name.

# --- Limits -------------------------------------------------------------
MAX_UPLOAD_MB=50
