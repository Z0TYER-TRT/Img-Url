# --- Site ---------------------------------------------------------------
# Your DuckDNS name without the https:// part. Caddy uses it for the cert.
PUBLIC_HOST=myimages.duckdns.org
# Full origin the API puts in generated links (scheme + host).
PUBLIC_ORIGIN=https://myimages.duckdns.org

# DuckDNS token — used only by scripts/duckdns.sh to update the A record.
# The app itself never reads this. Leave empty if you set the IP in the dashboard.
DUCKDNS_TOKEN=

# --- Admin login --------------------------------------------------------
# The single account that can upload. Password: 8 to 15 characters.
ADMIN_EMAIL=you@gmail.com
ADMIN_PASSWORD=changeme123
# 32+ random characters, e.g. `openssl rand -hex 32`
SESSION_SECRET=replace-with-32-plus-random-characters

# --- Database -----------------------------------------------------------
MONGODB_URI=mongodb://mongo:27017/imgurl

# --- Storage ------------------------------------------------------------
# JSON array of 1 to 10 Backblaze B2 application keys.
# region is the bucket region, e.g. us-west-004.
B2_ACCOUNTS=[{"keyId":"0000000000000","appKey":"K00000000000000000000000000000000000","bucket":"my-imgurl-bucket","region":"us-west-004"}]

# --- Limits -------------------------------------------------------------
MAX_UPLOAD_MB=50
